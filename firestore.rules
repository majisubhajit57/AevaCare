rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAuthorizedOwner(userId) {
      return isOwner(userId) && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Master Gate helper for subcollections under /careProfiles/{userId}
    function hasParentCareProfile(userId) {
      return exists(/databases/$(database)/documents/careProfiles/$(userId)) &&
        get(/databases/$(database)/documents/careProfiles/$(userId)).data.ownerId == request.auth.uid;
    }

    // Validation Blueprint: CareProfile
    function isValidCareProfile(data) {
      return data.keys().hasAll([
          'ownerId',
          'email',
          'displayName',
          'role',
          'familyNamesCsv',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'email',
          'displayName',
          'role',
          'familyNamesCsv',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 20 &&
        (data.role == 'elderly' || data.role == 'caretaker' || data.role == 'family') &&
        data.familyNamesCsv is string && data.familyNamesCsv.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: MedicationRecord
    function isValidMedicationRecord(data) {
      return data.keys().hasAll([
          'ownerId',
          'medId',
          'brandName',
          'genericName',
          'dosage',
          'whatItIsFor',
          'timeSlot',
          'scheduledTime',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'medId',
          'brandName',
          'genericName',
          'dosage',
          'whatItIsFor',
          'timeSlot',
          'scheduledTime',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.medId is string && data.medId.size() >= 1 && data.medId.size() <= 128 && data.medId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 120 &&
        data.genericName is string && data.genericName.size() >= 1 && data.genericName.size() <= 120 &&
        data.dosage is string && data.dosage.size() >= 1 && data.dosage.size() <= 60 &&
        data.whatItIsFor is string && data.whatItIsFor.size() >= 1 && data.whatItIsFor.size() <= 300 &&
        data.timeSlot is string && data.timeSlot.size() >= 1 && data.timeSlot.size() <= 20 &&
        (data.timeSlot == 'Morning' || data.timeSlot == 'Afternoon' || data.timeSlot == 'Evening') &&
        data.scheduledTime is string && data.scheduledTime.size() >= 1 && data.scheduledTime.size() <= 40 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 20 &&
        (data.status == 'Taken' || data.status == 'Due Now' || data.status == 'Upcoming' || data.status == 'Snoozed' || data.status == 'Missed') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection 1: /careProfiles/{userId}
    match /careProfiles/{userId} {
      allow get: if isOwner(userId) &&
        isValidId(userId) &&
        (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isAuthorizedOwner(userId) &&
        isValidId(userId) &&
        isValidCareProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAuthorizedOwner(userId) &&
        isValidId(userId) &&
        isValidCareProfile(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role', 'familyNamesCsv', 'createdAt', 'updatedAt']);

      allow delete: if isAuthorizedOwner(userId) &&
        isValidId(userId) &&
        existing().ownerId == request.auth.uid;

      // Subcollection 2: /careProfiles/{userId}/medications/{medId}
      match /medications/{medId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(medId) &&
          (resource == null || existing().ownerId == request.auth.uid);

        allow list: if isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isAuthorizedOwner(userId) &&
          isValidId(userId) &&
          isValidId(medId) &&
          isValidMedicationRecord(incoming()) &&
          incoming().medId == medId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasParentCareProfile(userId);

        allow update: if isAuthorizedOwner(userId) &&
          isValidId(userId) &&
          isValidId(medId) &&
          isValidMedicationRecord(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().medId == existing().medId &&
          (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
          incoming().updatedAt == request.time &&
          (
            // Action 1: Update dose adherence status
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            // Action 2: Edit or idempotently sync medication schedule details
            incoming().diff(existing()).affectedKeys().hasOnly([
              'brandName',
              'genericName',
              'dosage',
              'whatItIsFor',
              'timeSlot',
              'scheduledTime',
              'status',
              'createdAt',
              'updatedAt'
            ])
          ) &&
          hasParentCareProfile(userId);

        allow delete: if isAuthorizedOwner(userId) &&
          isValidId(userId) &&
          isValidId(medId) &&
          existing().ownerId == request.auth.uid &&
          hasParentCareProfile(userId);
      }
    }
  }
}
